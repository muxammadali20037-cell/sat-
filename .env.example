# ── SAT MASTER environment ──────────────────────────────────────────────
# Copy to .env.local for development. Never commit real secrets.
# Variables without NEXT_PUBLIC_ are server-only and must never reach the browser.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google sign-in (also enable the Google provider in Supabase Auth)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Graphing calculator — Desmos API key (desmos.com/my-api). Domain-bound browser key; check
# Desmos's API terms for commercial use. Without it the calculator panel links out to desmos.com.
NEXT_PUBLIC_DESMOS_API_KEY=
NEXT_PUBLIC_DESMOS_API_VERSION=v1.13

# AI tutor — Anthropic Claude
ANTHROPIC_API_KEY=
# anthropic (default) | mock (development only; refused in production)
AI_PROVIDER=anthropic
AI_MODEL_TUTOR=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Video — Bunny Stream with token authentication (optional; Supabase Storage works without it)
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_TOKEN_KEY=

# Payments — Click (Shop API)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# Payments — Payme (Merchant API)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_TEST_MODE=true

# Payments — Stripe (international, subject to merchant eligibility)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Simulated payment provider for local development (refused in production)
PAYMENTS_TEST_MODE=false
PAYMENTS_TEST_WEBHOOK_SECRET=

# Scheduled jobs (renewal reminders). Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Telegram Mini App (docs/TELEGRAM.md). Server only — never NEXT_PUBLIC_.
# Token from @BotFather; webhook secret: 16–256 characters of A–Z a–z 0–9 _ - (e.g. `openssl rand -hex 32`).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
